<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Port Brief · {{ issue_long }}</title>
<style>
@font-face { font-family: "Plex"; src: url("../fonts/IBMPlexSans-Regular.ttf"); font-weight: 400; }
@font-face { font-family: "Plex"; src: url("../fonts/IBMPlexSans-Medium.ttf"); font-weight: 500; }
@font-face { font-family: "Plex"; src: url("../fonts/IBMPlexSans-SemiBold.ttf"); font-weight: 600; }
@font-face { font-family: "Plex"; src: url("../fonts/IBMPlexSans-Bold.ttf"); font-weight: 700; }
@font-face { font-family: "PlexMono"; src: url("../fonts/IBMPlexMono-Regular.ttf"); }

:root {
  --page: #0b1826;
  --surface: #0f1e2e;
  --raised: #142739;
  --ink: #ffffff;
  --ink2: #c3cad3;
  --muted: #8a96a3;
  --rule: #1e3044;
  --brand: #3fb6c9;
  --watch: #fab219;
  --likely: #d03b3b;
  --si: #3987e5;
  --xe: #d95926;
}
@page {
  size: A4;
  margin: 14mm 13mm 16mm 13mm;
  background: var(--page);
  @bottom-left { content: "Port Brief · {{ issue_long }}"; font: 7pt "Plex"; color: #8a96a3; }
  @bottom-right { content: counter(page) " / " counter(pages); font: 7pt "Plex"; color: #8a96a3; }
}
* { box-sizing: border-box; }
body { font-family: "Plex", sans-serif; font-size: 8.8pt; line-height: 1.45; color: var(--ink2); margin: 0; background: var(--page); }
h1, h2, h3 { color: var(--ink); margin: 0; font-weight: 600; }
h2 { font-size: 12.5pt; letter-spacing: 0.01em; margin: 0 0 2.5mm; }
h2 .kicker { display: block; font-size: 7pt; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); margin-bottom: 1mm; }
h3 { font-size: 9.5pt; margin: 0 0 1.5mm; }
p { margin: 0 0 2.2mm; }
.page-break { break-before: page; }
.muted { color: var(--muted); }
.mono, td.num { font-family: "PlexMono", monospace; font-variant-numeric: tabular-nums; }

/* Masthead */
.masthead { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1.2pt solid var(--brand); padding-bottom: 2.5mm; margin-bottom: 5mm; }
.brand { font-size: 22pt; font-weight: 700; color: var(--ink); letter-spacing: 0.06em; }
.brand span { color: var(--brand); }
.tagline { font-size: 7.5pt; color: var(--muted); letter-spacing: 0.04em; }
.issue-date { text-align: right; font-size: 8pt; color: var(--ink2); }
.issue-date strong { display: block; color: var(--ink); font-size: 10pt; }

.headline { font-size: 19pt; line-height: 1.15; font-weight: 600; color: var(--ink); margin: 0 0 3mm; }
.standfirst { font-size: 10.5pt; line-height: 1.45; color: var(--ink2); margin-bottom: 5mm; }

/* Stat tiles */
.tiles { display: flex; gap: 3mm; margin-bottom: 5mm; }
.tile { flex: 1; background: var(--surface); border: 0.6pt solid var(--rule); border-radius: 2mm; padding: 3mm 3.5mm; }
.tile .label { font-size: 6.8pt; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
.tile .value { font-size: 17pt; font-weight: 600; color: var(--ink); line-height: 1.2; }
.tile .sub { font-size: 7pt; color: var(--muted); }

/* Panels & tables */
.panel { background: var(--surface); border: 0.6pt solid var(--rule); border-radius: 2mm; padding: 3.5mm 4mm; margin-bottom: 4mm; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 6.8pt; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 1.2mm 1.5mm; border-bottom: 0.6pt solid var(--rule); }
td { padding: 1.5mm 1.5mm; border-bottom: 0.4pt solid var(--rule); vertical-align: top; }
tr:last-child td { border-bottom: none; }
table.compact td { padding-top: 0.8mm; padding-bottom: 0.8mm; }
td.name { color: var(--ink); font-weight: 500; white-space: nowrap; }

.chip { display: inline-block; font-size: 6.8pt; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.4mm 1.6mm; border-radius: 1mm; }
.chip.watch { background: var(--watch); color: #1a1300; }
.chip.likely { background: var(--likely); color: #ffffff; }
.trend { font-size: 7.5pt; color: var(--muted); }
.trend.deteriorating { color: var(--ink); font-weight: 600; }

/* Heat strip */
table.strip td.cell { text-align: center; padding: 1.1mm 0.5mm; white-space: nowrap; font-family: "PlexMono", monospace; font-size: 6.6pt; color: var(--muted); border-left: 1.5pt solid var(--surface); border-bottom: 1.5pt solid var(--surface); }
table.strip td.cell.watch { background: var(--watch); color: #1a1300; }
table.strip td.cell.likely { background: var(--likely); color: #ffffff; }
table.strip td.cell.none { background: var(--raised); }
table.strip td.cell b { font-family: "Plex"; font-size: 6.6pt; margin-right: 0.8mm; }
table.strip td { padding-top: 1.1mm; padding-bottom: 1.1mm; }
table.strip th.day { text-align: center; }
.legend { font-size: 7pt; color: var(--muted); margin-top: 2mm; }
.legend .sw { display: inline-block; width: 3mm; height: 3mm; border-radius: 0.6mm; vertical-align: -0.4mm; margin: 0 1mm 0 3mm; }

.cols { display: flex; gap: 4mm; align-items: flex-start; }
.cols > * { flex: 1; }
.chart svg { width: 100%; height: auto; }
ul.adv { list-style: none; padding: 0; margin: 0; }
ul.adv li { padding: 1.2mm 0; border-bottom: 0.4pt solid var(--rule); }
ul.adv li:last-child { border-bottom: none; }
ul.adv a { color: var(--ink); text-decoration: none; }
.new { color: var(--brand); font-weight: 700; font-size: 6.5pt; letter-spacing: 0.08em; margin-right: 1mm; }
.adv-panel { break-inside: auto; }
ul.adv li { break-inside: avoid; }
.fine { font-size: 7pt; color: var(--muted); line-height: 1.4; }
.fine p { margin-bottom: 1.5mm; }
.draft-banner { background: var(--watch); color: #1a1300; font-weight: 700; text-align: center; padding: 1.5mm; border-radius: 1mm; margin-bottom: 4mm; font-size: 8pt; letter-spacing: 0.1em; }
</style>
</head>
<body>

{% if meta.mode == 'dry-run' %}<div class="draft-banner">DRY RUN · CACHED DATA · NOT FOR DISTRIBUTION</div>{% endif %}

<div class="masthead">
  <div>
    <div class="brand">PORT<span>·</span>BRIEF</div>
    <div class="tagline">Freight intelligence for UK forwarders, importers &amp; logistics managers</div>
  </div>
  <div class="issue-date"><strong>{{ issue_long }}</strong>Forecast run {{ generated_at[:16].replace('T', ' ') }} UTC</div>
</div>

<h1 class="headline">{{ ed.headline }}</h1>
<p class="standfirst">{{ ed.standfirst }}</p>

<div class="tiles">
  <div class="tile"><div class="label">Deteriorating in 3–5 days</div><div class="value">{{ deteriorating_count }}</div><div class="sub">of {{ ports|length + lanes|length }} ports &amp; lanes tracked</div></div>
  <div class="tile"><div class="label">Global reliability · Sea-Intelligence</div><div class="value">{% if si and si.global_pct is not none %}{{ si.global_pct }}%{% else %}–{% endif %}</div><div class="sub">{% if si %}{{ si.period|period }}{% if si.mom_pp is not none %} · {{ si.mom_pp|pp }} m/m{% endif %}{% endif %}</div></div>
  <div class="tile"><div class="label">Global reliability · Xeneta</div><div class="value">{% if xe and xe.global_pct is not none %}{{ xe.global_pct }}%{% else %}–{% endif %}</div><div class="sub">{% if xe %}{{ xe.period|period }}{% if xe.global_mom_pp is not none %} · {{ xe.global_mom_pp|pp }} m/m{% endif %}{% endif %}</div></div>
  <div class="tile"><div class="label">Tropical cyclones</div><div class="value">{{ storms_near|length }}</div><div class="sub">near tracked locations · {{ storms|length }} active worldwide</div></div>
</div>

<div class="panel">
  <h2><span class="kicker">The question this issue answers</span>Watchlist: where conditions turn next</h2>
  {% if watchlist %}
  <table>
    <tr><th>Risk</th><th>Port / lane</th><th>When</th><th>Why</th><th>Trend</th></tr>
    {% for w in watchlist %}
    <tr>
      <td><span class="chip {{ w.level }}">{{ w.level|glyph }} {{ w.level }}</span></td>
      <td class="name">{{ w.name }}</td>
      <td style="white-space:nowrap">{{ w.peak_day|day }}</td>
      <td>{{ ed.watchlist_notes.get(w.id) or (w.causes|map('cause')|join(', ')) }}</td>
      <td><span class="trend {{ w.trend }}">{{ w.trend }}</span></td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No port or lane we track reaches a watch threshold in the next six days.</p>
  {% endif %}
</div>

<!-- ========================= PORTS ========================= -->
<div class="page-break"></div>
<h2><span class="kicker">Ports · six-day operational outlook</span>UK and North European gateways first</h2>
<p>{{ ed.sections.ports }}</p>

<div class="panel">
<table class="strip">
  <tr><th>Port</th>{% for d in day_keys %}<th class="day">{{ d|short_day }}<br><span class="mono">{{ d[8:] }}</span></th>{% endfor %}<th>Occupancy</th></tr>
  {% for a in ports %}
  <tr>
    <td class="name">{{ a.name }}</td>
    {% for d in a.days %}
    <td class="cell {{ d.level }}">{% if d.level != 'none' %}<b>{{ d.level|glyph }}</b>{% endif %}{{ d.gust_max|num(0) }} · {{ d.hs_max|num(1) }}</td>
    {% endfor %}
    {% set c = congestion.get(a.id) %}
    <td class="num">{% if c and c.occupancy_pct is not none %}{{ c.occupancy_pct|num(0) }}%{% if c.occupancy_gap_vs_mean_pct is not none %} <span class="muted">({{ c.occupancy_gap_vs_mean_pct|num(0) }})</span>{% endif %}{% else %}<span class="muted">n/a</span>{% endif %}</td>
  </tr>
  {% endfor %}
</table>
<div class="legend">Cells: peak gust m/s · peak sea m (UTC days).
  <span class="sw" style="background:#fab219"></span>▲ Watch
  <span class="sw" style="background:#d03b3b"></span>◆ Likely
  — crane stoppages from gusts ≥ {{ port_t.crane_watch_gust|num(0) }} / {{ port_t.crane_likely_gust|num(0) }} m/s; pilot boarding from sea ≥ {{ port_t.pilot_watch_hs }} / {{ port_t.pilot_likely_hs }} m or long-period swell.
  Occupancy: Sinay berth occupancy (gap vs port's usual level, pp).</div>
</div>

<!-- ========================= LANES ========================= -->
<h2><span class="kicker">Lanes &amp; chokepoints</span>Sea state on the routes into Europe</h2>
<p>{{ ed.sections.lanes }}</p>
<div class="panel">
<table class="strip">
  <tr><th>Lane</th>{% for d in day_keys %}<th class="day">{{ d|short_day }}<br><span class="mono">{{ d[8:] }}</span></th>{% endfor %}</tr>
  {% for a in lanes %}
  <tr>
    <td class="name">{{ a.name }}</td>
    {% for d in a.days %}
    <td class="cell {{ d.level }}">{% if d.level != 'none' %}<b>{{ d.level|glyph }}</b>{% endif %}{{ d.hs_max|num(1) }} · {{ d.wind_max|num(0) }}</td>
    {% endfor %}
  </tr>
  {% endfor %}
</table>
<div class="legend">Cells: peak sea m · peak wind m/s.
  <span class="sw" style="background:#fab219"></span>▲ Watch (sea ≥ {{ lane_t.lane_watch_hs|num(0) }} m or gale)
  <span class="sw" style="background:#d03b3b"></span>◆ Likely (sea ≥ {{ lane_t.lane_likely_hs|num(0) }} m or severe gale). Agulhas also flags south-west swell against the current.</div>
</div>

<div class="cols">
  <div class="panel">
    <h3>Forecast drift since the last run</h3>
    {% if drift %}
    <table>
      <tr><th>Where</th><th>Day</th><th>Gust</th><th>Sea</th></tr>
      {% for d in drift %}
      <tr><td class="name">{{ d.name }}</td><td>{{ d.date|day }}</td>
        <td class="num">{{ d.gust_prev|num(0) }}→{{ d.gust_now|num(0) }}</td>
        <td class="num">{{ d.hs_prev|num(1) }}→{{ d.hs_now|num(1) }}</td></tr>
      {% endfor %}
    </table>
    {% else %}<p class="muted">No material change versus the previous forecast{% if not drift %} (or no previous run to compare){% endif %}.</p>{% endif %}
  </div>
  <div class="panel">
    <h3>Tropical cyclones</h3>
    {% if storms %}
    <table>
      <tr><th>Storm</th><th>Strength</th><th>Nearest tracked</th></tr>
      {% for s in storms[:5] %}
      <tr><td class="name">{{ s.name }}</td><td>{{ s.severity or s.alert_level }}</td>
        <td>{% if s.nearby %}{{ by_id[s.nearby[0].id].name }} · {{ s.nearby[0].distance_km }} km{% else %}<span class="muted">none within 1,200 km</span>{% endif %}</td></tr>
      {% endfor %}
    </table>
    {% else %}<p class="muted">No active tropical cyclones.</p>{% endif %}
  </div>
</div>

<!-- ========================= RELIABILITY ========================= -->
<h2 style="margin-top:6mm"><span class="kicker">Schedule reliability · monthly, ~4–6 weeks lagged</span>Two benchmarks, two definitions of on time</h2>
<p>{{ ed.sections.reliability }}</p>

<div class="cols">
  <div class="panel chart">
    <h3>Global on-time share</h3>
    {% if trend_svg %}{{ trend_svg|safe }}{% else %}<p class="muted">Unavailable.</p>{% endif %}
  </div>
  <div class="panel chart">
    <h3>Carriers: same month, two methods</h3>
    {% if dumbbell_svg %}{{ dumbbell_svg|safe }}{% else %}<p class="muted">Unavailable.</p>{% endif %}
  </div>
</div>

<div class="panel">
  <table class="compact">
    <tr><th>Carrier</th><th>Sea-Intelligence{% if si %} {{ si.period|period }}{% endif %}</th><th>Rank</th><th>Xeneta{% if xe %} {{ xe.period|period }}{% endif %}</th><th>Rank</th><th>Gap</th></tr>
    {% set xe_rows = dv.carriers if dv and dv.comparable else [] %}
    {% for c in (si.carriers if si else []) %}
      {% set m = (xe_rows|selectattr('carrier', 'equalto', c.carrier)|list) %}
      <tr><td class="name">{{ c.carrier }}</td><td class="num">{{ c.pct|num(1) }}%</td><td class="num">{{ c.rank }}</td>
        {% if m %}<td class="num">{{ m[0].xeneta_pct|num(0) }}%</td><td class="num">{{ m[0].xeneta_rank }}</td><td class="num">{{ m[0].gap_pp|pp }}</td>
        {% else %}<td class="muted">–</td><td></td><td></td>{% endif %}</tr>
    {% endfor %}
  </table>
  <div class="fine" style="margin-top:2mm">
    {% if si %}<p><strong>Sea-Intelligence</strong>: {{ si.methodology }}{% if si.avg_delay_late_days %} Average delay for late arrivals {{ si.avg_delay_late_days }} days.{% endif %}{% if si.stale_since %} <em>Latest release not reachable; showing last published figures.</em>{% endif %}</p>{% endif %}
    {% if xe %}<p><strong>Xeneta</strong>: {{ xe.methodology }}{% if xe.carrier_count_note %} {{ xe.carrier_count_note }}{% endif %}</p>{% endif %}
    {% if dv and dv.comparable %}<p>Gap = Sea-Intelligence minus Xeneta, percentage points. {{ dv.note }}</p>{% elif dv %}<p>{{ dv.note }}</p>{% endif %}
  </div>
</div>

<!-- ========================= ADVISORIES ========================= -->
<h2 style="margin-top:6mm"><span class="kicker">Port &amp; carrier notices · past seven days</span>Advisories</h2>
<p>{{ ed.sections.advisories }}</p>
{% for kind, label in [('port', 'Ports'), ('carrier', 'Carriers')] %}
<div class="panel adv-panel">
  <h3>{{ label }}</h3>
  {% set groups = adv_groups|selectattr('kind', 'equalto', kind)|list %}
  {% if groups %}
  <ul class="adv">
    {% for g in groups %}{% for i in g['items'] %}
    <li>{% if i.is_new %}<span class="new">NEW</span>{% endif %}<a href="{{ i.url }}">{{ i.title }}</a>
      <span class="muted"> · {{ g.name }} · {{ i.published or '' }} · {{ i.via.replace('Google News / ', '') if i.via != 'direct' else 'official site' }}</span></li>
    {% endfor %}{% endfor %}
  </ul>
  {% else %}<p class="muted">Nothing operational this week.</p>{% endif %}
</div>
{% endfor %}

<div class="panel fine">
  <h3>Sources, method &amp; data health</h3>
  <p>Weather is treated as a leading indicator: flags mark days when forecast wind or sea state reach levels at which crane work or pilot boarding is commonly suspended, or heavy weather slows transits. They are probabilistic signals, not port notices; always confirm with your terminal or carrier.</p>
  <p>{% for a in attributions %}{{ a.rstrip(".") }}.{% if not loop.last %} {% endif %}{% endfor %}</p>
  <p>Data health this run: {% for name, h in health.items() %}{{ name.replace('_', ' ') }} <strong>{{ h.status }}</strong>{% if not loop.last %} · {% endif %}{% endfor %}.</p>
</div>

</body>
</html>
