<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Port Brief, {{ issue_long }}</title>
<style>
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Regular.ttf"); font-weight: 400; font-style: normal; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-It.ttf"); font-weight: 400; font-style: italic; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Semibold.ttf"); font-weight: 600; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Bold.ttf"); font-weight: 700; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Regular.ttf"); font-weight: 400; font-style: normal; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-It.ttf"); font-weight: 400; font-style: italic; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Semibold.ttf"); font-weight: 600; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Bold.ttf"); font-weight: 700; }

@page {
  size: A4;
  margin: 16mm 18mm 18mm 18mm;
  @bottom-left { content: "Port Brief, {{ issue_long }}"; font: 7.5pt "PBSans"; color: #6b6b66; }
  @bottom-right { content: counter(page) " of " counter(pages); font: 7.5pt "PBSans"; color: #6b6b66; }
}
@page :first { @bottom-left { content: none; } }

html { color: #111; }
body { font-family: "PBSerif", Georgia, serif; font-size: 9.6pt; line-height: 1.42; margin: 0; background: #fff; hyphens: auto; }
p { margin: 0 0 2.4mm; }
a { color: inherit; text-decoration: none; }
.sans { font-family: "PBSans", sans-serif; }
.small { font-family: "PBSans", sans-serif; font-size: 7.8pt; color: #55554f; line-height: 1.35; }
.num { font-family: "PBSans", sans-serif; font-variant-numeric: tabular-nums lining-nums; }

/* Masthead */
.mast { display: flex; justify-content: space-between; align-items: baseline; }
.wordmark { white-space: nowrap; font-size: 30pt; font-weight: 700; letter-spacing: -0.01em; color: #14365c; line-height: 1; }
.dateline { font-family: "PBSans", sans-serif; font-size: 8.5pt; color: #333; text-align: right; }
.tagline { font-style: italic; font-size: 9pt; color: #55554f; margin: 1.5mm 0 0; }
.rule-double { border-top: 1.4pt solid #14365c; border-bottom: 0.5pt solid #14365c; height: 1.2pt; margin: 2.5mm 0 5mm; }
.notice-line { font-family: "PBSans", sans-serif; font-size: 8pt; color: #b3261e; margin-bottom: 3mm; }

h1 { font-size: 21pt; font-weight: 600; line-height: 1.12; margin: 0 0 3mm; letter-spacing: -0.005em; }
.lede { font-size: 11pt; line-height: 1.42; color: #222; margin-bottom: 5mm; max-width: 150mm; }
h2 { font-size: 13.5pt; font-weight: 700; margin: 7mm 0 2.5mm; padding-top: 2mm; border-top: 0.6pt solid #111; }
h2.first { margin-top: 0; }
h3 { font-size: 10pt; font-weight: 700; margin: 4mm 0 1.5mm; }
.page-break { break-before: page; }

/* Tables */
table { width: 100%; border-collapse: collapse; }
th { font-family: "PBSans", sans-serif; font-weight: 600; font-size: 7.8pt; text-align: left; color: #333; padding: 1.4mm 2mm 1.4mm 0; border-bottom: 0.6pt solid #111; vertical-align: bottom; }
td { padding: 1.6mm 2mm 1.6mm 0; border-bottom: 0.4pt solid #d8d7d0; vertical-align: top; }
tr.group td { font-style: italic; color: #55554f; border-bottom: 0.4pt solid #b9b8ae; padding-top: 3.2mm; padding-bottom: 1mm; }
tr { break-inside: avoid; }
table.compact td { padding-top: 0.9mm; padding-bottom: 0.9mm; font-size: 9pt; }

/* The ports table */
table.ports td { font-size: 9.2pt; line-height: 1.36; }
table.ports td.port { font-weight: 700; width: 26mm; }
table.ports td.status { width: 30mm; font-family: "PBSans", sans-serif; font-size: 8.4pt; white-space: nowrap; }
table.ports td.detail { width: 36mm; font-size: 7.4pt; }
.sq { display: inline-block; width: 2.2mm; height: 2.2mm; margin-right: 1.4mm; vertical-align: 0.1mm; }

/* Figures */
figure { margin: 0 0 4mm; break-inside: avoid; }
figure svg { width: 100%; height: auto; display: block; }
figcaption { font-family: "PBSans", sans-serif; font-size: 7.8pt; color: #55554f; margin-top: 1.2mm; line-height: 1.35; }
.fig-title { font-family: "PBSans", sans-serif; font-weight: 600; font-size: 8.4pt; margin-bottom: 1.2mm; }
.two { display: table; width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
.two > * { display: table-cell; vertical-align: top; width: 50%; }
.two > * + * { padding-left: 7mm; }

/* Forecast grid */
table.grid td, table.grid th { text-align: center; padding: 1.2mm 0.6mm; font-size: 7.8pt; }
table.grid td:first-child, table.grid th:first-child { text-align: left; font-family: "PBSerif", serif; font-size: 8.8pt; }
table.grid td.watch { background: #fbf1dc; font-weight: 700; }
table.grid td.likely { background: #f6dcd8; font-weight: 700; }

/* Prose in columns */
.cols { column-count: 2; column-gap: 7mm; }
.notices .pub { font-family: "PBSans", sans-serif; font-weight: 700; font-size: 8.2pt; margin: 2.5mm 0 1mm; break-after: avoid; }
.notices .item { margin: 0 0 1.8mm; break-inside: avoid; }
.notices .item .src { display: block; }
.footnotes { margin-top: 6mm; border-top: 0.4pt solid #b9b8ae; padding-top: 2mm; }
.footnotes p { margin-bottom: 1.4mm; }
table.key td.n, table.key th.n { width: 8mm; }
.disc { display: inline-block; width: 4.2mm; height: 4.2mm; line-height: 4.2mm; border-radius: 50%; border: 0.6pt solid #111; text-align: center; font-family: "PBSans", sans-serif; font-weight: 700; font-size: 7pt; }
.swatch { display: inline-block; width: 5mm; height: 2.6mm; margin: 0 1.2mm 0 1.6mm; vertical-align: -0.2mm; opacity: 0.85; }
.swatch.sev-likely { background-image: radial-gradient(#4a2e0c 0.35pt, transparent 0.5pt); background-size: 1.1mm 1.1mm; }
.swatch.sev-extreme { background-image: repeating-linear-gradient(45deg, #4a2e0c 0 0.3pt, transparent 0.3pt 1.1mm); }
ul.drift { list-style: none; padding: 0; margin: 0; font-family: "PBSans", sans-serif; font-size: 8pt; line-height: 1.35; }
ul.drift li { padding: 1.2mm 0; border-bottom: 0.4pt solid #d8d7d0; }
</style>
</head>
<body>

{% if meta.mode == 'dry-run' %}<p class="notice-line">Dry run from cached data. Not for distribution.</p>{% endif %}
{% if meta.mode == 'illustration' %}<p class="notice-line">Illustration with synthetic congestion and weather, to show each port status. Not a real forecast.</p>{% endif %}

<div class="mast">
  <div class="wordmark">Port Brief</div>
  <div class="dateline">{% if issue_number %}Issue {{ issue_number }}, {% endif %}{{ issue_long }}</div>
</div>
<p class="tagline">Port and shipping conditions for UK importers, forwarders and logistics teams</p>
<div class="rule-double"></div>

<h1>{{ ed.headline }}</h1>
<p class="lede">{{ ed.standfirst }}</p>

<h2 class="first">The ports this week</h2>
<table class="ports">
  <tr><th>Port</th><th>Status</th><th>What to do</th><th>Detail</th></tr>
  {% for region, label in [('uk', 'United Kingdom'), ('north_europe', 'North Europe')] %}
  <tr class="group"><td colspan="4">{{ label }}</td></tr>
  {% for p in port_board if p.region == region %}
  <tr>
    <td class="port">{{ p.name }}</td>
    <td class="status"><span class="sq" style="background: {{ status_colours[p.status] }}"></span>{{ p.status_label }}</td>
    <td>{{ ed.port_notes.get(p.id) or p.actions|join(' ') }}</td>
    <td class="detail small">
      {%- if p.windows %}{{ 'Windy spell' if p.windows|length == 1 else 'Windy spells' }}:{% for w in p.windows[:3] %}<br>{{ w.short or w.label }}{% if w.peak_gust %}, {{ w.peak_gust|num(0) }} m/s{% endif %}{% endfor %}{% if p.windows|length > 3 %}<br>and {{ p.windows|length - 3 }} more{% endif %}<br>{% endif %}
      {%- set c = p.congestion %}
      {%- if c and c.occupancy_pct is not none %}Berths {{ c.occupancy_pct|num(0) }}% occupied{% if c.occupancy_gap_vs_mean_pct is not none %}, {{ c.occupancy_gap_vs_mean_pct|signed }} points on normal{% endif %}.{% if c.time_in_port_median_h is not none %} Median stay {{ c.time_in_port_median_h|num(0) }} hours.{% endif %}
      {%- elif not p.windows %}No crane or pilotage limits forecast.{% endif %}
    </td>
  </tr>
  {% endfor %}
  {% endfor %}
</table>
<p class="small" style="margin-top:2mm">
  {% if congestion_missing %}Congestion figures were not available for this issue, so each status reflects weather forecasts and port news only. {% endif %}
  Weather times are UK local time. Buffers follow the Port Brief playbook and assume normal carrier free time.
</p>

<!-- Weather -->
<h2>Weather on the routes into Europe</h2>
<p>{{ ed.inbound_note }}</p>

<figure>
  {{ world_map_svg|safe }}
  <figcaption class="legend-line">Highest seas over the next six days:
    {% for k in ['watch', 'likely', 'extreme'] %}<span style="white-space:nowrap"><span class="swatch sev-{{ k }}" style="background-color: {{ severity_colours[k] }}"></span>{{ severity_labels[k] }} {{ severity_sea[k]|num(0) }} m+</span>{{ ',' if not loop.last else '.' }} {% endfor %}
    Numbers refer to the table below. The box is the ports map.{% if not field_ok %} Sea-state shading was not available for this issue.{% endif %}</figcaption>
</figure>

{% if key_items %}
<table class="key">
  <tr><th class="n">No.</th><th>Sea area</th><th>Severity</th><th>When</th><th>Peak seas</th><th>Expected delay</th></tr>
  {% for i in key_items %}
  <tr>
    <td class="n"><span class="disc">{{ i.n }}</span></td>
    <td><strong>{{ i.name }}</strong><br><span class="small">{{ i.trades|sentence }}</span></td>
    <td class="small" style="white-space:nowrap"><span class="sq" style="background: {{ severity_colours[i.level] }}"></span>{{ i.severity }}</td>
    <td class="small" style="white-space:nowrap">{% if i.from_day %}{{ i.from_day|day }}{% if i.to_day and i.to_day != i.from_day %} to {{ i.to_day|day }}{% endif %}{% else %}Now{% endif %}</td>
    <td class="small num">{% if i.peak_sea %}{{ i.peak_sea|num(1) }} m{% endif %}</td>
    <td class="small" style="white-space:nowrap">{{ i.delay|sentence }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p class="small">No sea area on the main routes into Europe is forecast to be rough enough to delay ships in the next six days.</p>
{% endif %}

<div class="two" style="margin-top:4mm">
  <figure>
    <div class="fig-title">North European ports</div>
    {{ europe_map_svg|safe }}
    <figcaption>Ports coloured by this week's status: {% for k, label in [('normal', 'running normally'), ('watch', 'watch'), ('congested', 'congested'), ('disruption', 'disruption likely')] %}<span style="white-space:nowrap"><span class="sq" style="background: {{ status_colours[k] }}"></span>{{ label }}</span>{{ ', ' if not loop.last else '.' }} {% endfor %}</figcaption>
  </figure>
  <div>
    <div class="fig-title">Forecast changes since the last issue</div>
    {% if drift %}
    <ul class="drift">
      {% for d in drift %}
      <li><strong>{{ d.name }}</strong>, {{ d.date|day }}: {% if d.gust_delta and d.gust_delta|abs >= 3 %}gusts {{ d.gust_prev|num(0) }} to {{ d.gust_now|num(0) }} m/s{% endif %}{% if d.gust_delta and d.gust_delta|abs >= 3 and d.hs_delta and d.hs_delta|abs >= 1 %}, {% endif %}{% if d.hs_delta and d.hs_delta|abs >= 1 %}seas {{ d.hs_prev|num(1) }} to {{ d.hs_now|num(1) }} m{% endif %}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="small">No material change in the forecasts since the last issue.</p>
    {% endif %}
  </div>
</div>

<h3>Six-day forecast at the ports</h3>
<table class="grid">
  <tr><th>Peak gusts (m/s) and sea (m)</th>{% for d in day_keys %}<th>{{ d|short_day }} {{ d[8:]|int }}</th>{% endfor %}</tr>
  {% for a in ports %}
  <tr>
    <td>{{ a.name }}</td>
    {% for d in a.days %}<td class="num {{ d.level }}">{{ d.gust_max|num(0) }} / {{ d.hs_max|num(1) }}</td>{% endfor %}
  </tr>
  {% endfor %}
</table>
<p class="small" style="margin-top:1.5mm">Shaded amber where gusts reach {{ port_t.crane_watch_gust|num(0) }} m/s or seas reach {{ port_t.pilot_watch_hs }} m, when crane work or pilot boarding may pause; red from {{ port_t.crane_likely_gust|num(0) }} m/s or {{ port_t.pilot_likely_hs }} m, when it usually stops. Days run midnight to midnight UTC.</p>

<!-- Reliability -->
<h2>Schedule reliability</h2>
<div class="cols"><p>{{ ed.sections.reliability }}</p></div>

<div class="two">
  <figure>
    <div class="fig-title">Share of ships arriving on time, worldwide</div>
    {% if trend_svg %}{{ trend_svg|safe }}{% else %}<p class="small">Not available this issue.</p>{% endif %}
  </figure>
  <figure>
    <div class="fig-title">The same carriers, measured two ways{% if dv and dv.period %}, {{ dv.period|period }}{% endif %}</div>
    {% if dumbbell_svg %}{{ dumbbell_svg|safe }}{% else %}<p class="small">Not available this issue.</p>{% endif %}
  </figure>
</div>

<table class="compact">
  <tr><th>Carrier</th><th>Sea-Intelligence{% if si %}, {{ si.period|period }}{% endif %}</th><th>Xeneta{% if xe %}, {{ xe.period|period }}{% endif %}</th><th>Difference, points</th></tr>
  {% set xe_rows = dv.carriers if dv and dv.comparable else [] %}
  {% for c in (si.carriers if si else []) %}
    {% set m = (xe_rows|selectattr('carrier', 'equalto', c.carrier)|list) %}
    <tr><td>{{ c.carrier }}</td><td class="num">{{ c.pct|num(1) }}%</td>
      {% if m %}<td class="num">{{ m[0].xeneta_pct|num(0) }}%</td><td class="num">{{ m[0].gap_pp|signed }}</td>{% else %}<td class="small">Not ranked</td><td></td>{% endif %}</tr>
  {% endfor %}
</table>
<div class="small" style="margin-top:2mm">
  {% if si %}<p>Sea-Intelligence counts an arrival as on time if it is within one day of schedule (34 trade lanes, 60+ carriers).{% if si.avg_delay_late_days %} Late ships arrived {{ si.avg_delay_late_days }} days behind schedule on average.{% endif %}{% if si.stale_since %} The latest release could not be reached, so these are the last published figures.{% endif %}</p>{% endif %}
  {% if xe %}<p>Xeneta counts only arrivals on the scheduled day.{% if xe.carrier_count_note %} {{ xe.carrier_count_note }}{% endif %}</p>{% endif %}
</div>

<!-- Notices -->
<h2>Notices from ports and carriers</h2>
<p>{{ ed.sections.advisories }}</p>
<div class="cols notices">
  {% for g in adv_groups %}
  <div class="pub">{{ g.name }}</div>
  {% for i in g['items'] %}
  <div class="item"><a href="{{ i.url }}">{{ i.title }}</a>
    <span class="small src">{{ i.via.replace('Google News / ', '') if i.via != 'direct' else 'Official notice' }}{% if i.published %}, {{ i.published|day }}{% endif %}{% if i.is_new %}. New since the last issue{% endif %}</span></div>
  {% endfor %}
  {% else %}
  <p class="small">No operational notices this week.</p>
  {% endfor %}
</div>

<div class="footnotes small">
  <p><strong>How to read this brief.</strong> Weather flags are forecasts, not port notices: they mark the hours when wind or sea is likely to reach the levels at which terminals usually pause crane work or pilots stop boarding. Always confirm with your terminal or carrier before changing plans.</p>
  <p><strong>Sources.</strong> {% for a in attributions %}{{ a.rstrip('.') }}.{% if not loop.last %} {% endif %}{% endfor %} Maps use Natural Earth data.</p>
  <p><strong>Data this issue.</strong> {% for name, h in health.items() %}{{ health_names.get(name, name) }}: {{ health_words.get(h.status, h.status) }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
</div>

</body>
</html>
