<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Port Brief, {{ issue_long }}</title>
<style>
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Regular.ttf"); font-weight: 400; font-style: normal; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-It.ttf"); font-weight: 400; font-style: italic; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Semibold.ttf"); font-weight: 600; }
@font-face { font-family: "PBSerif"; src: url("../fonts/SourceSerif4-Bold.ttf"); font-weight: 700; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Regular.ttf"); font-weight: 400; font-style: normal; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-It.ttf"); font-weight: 400; font-style: italic; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Semibold.ttf"); font-weight: 600; }
@font-face { font-family: "PBSans"; src: url("../fonts/SourceSans3-Bold.ttf"); font-weight: 700; }

@page {
  size: A4;
  margin: 14mm 16mm 16mm 16mm;
  @bottom-left { content: "Port Brief, {{ issue_long }}"; font: 7.5pt "PBSans"; color: #6b6b66; }
  @bottom-right { content: counter(page) " of " counter(pages); font: 7.5pt "PBSans"; color: #6b6b66; }
}
@page :first { @bottom-left { content: none; } }

html { color: #111; }
body { font-family: "PBSans", sans-serif; font-size: 8.6pt; line-height: 1.35; margin: 0; background: #fff; }
p { margin: 0 0 2mm; }
a { color: inherit; text-decoration: none; }
.serif { font-family: "PBSerif", Georgia, serif; }
.muted { color: #6b6b66; }
.small { font-size: 7.6pt; color: #55554f; }
.num { font-variant-numeric: tabular-nums lining-nums; }
.page-break { break-before: page; }
.notice-line { font-size: 8pt; color: #b3261e; margin-bottom: 2.5mm; }

/* Masthead */
.mast { display: flex; justify-content: space-between; align-items: baseline; }
.wordmark { font-family: "PBSerif", serif; white-space: nowrap; font-size: 28pt; font-weight: 700; color: #14365c; line-height: 1; }
.dateline { font-size: 8.5pt; color: #333; text-align: right; }
.rule-double { border-top: 1.4pt solid #14365c; border-bottom: 0.5pt solid #14365c; height: 1.2pt; margin: 2.5mm 0 4mm; }
h1 { font-family: "PBSerif", serif; font-size: 19pt; font-weight: 600; line-height: 1.12; margin: 0 0 3mm; }

/* This issue */
.overview { display: table; width: 100%; table-layout: fixed; margin-bottom: 4mm; }
.overview > div { display: table-cell; vertical-align: top; }
.overview .lines { width: 47%; padding-right: 5mm; }
.ov-line { display: table; width: 100%; border-top: 0.5pt solid #d8d7d0; padding: 2mm 0; }
.ov-line:last-child { border-bottom: 0.5pt solid #d8d7d0; }
.ov-num { display: table-cell; width: 7mm; font-family: "PBSerif", serif; font-weight: 700; font-size: 15pt; color: #14365c; vertical-align: top; line-height: 1; }
.ov-body { display: table-cell; }
.ov-title { font-weight: 700; font-size: 8pt; color: #333; }
.ov-text { font-family: "PBSerif", serif; font-size: 10.2pt; line-height: 1.3; }
.overview svg { width: 100%; height: auto; display: block; }

/* Part headings */
h2 { font-family: "PBSerif", serif; font-size: 14pt; font-weight: 700; margin: 4mm 0 2mm; padding-top: 1.5mm; border-top: 1pt solid #111; }
h2 .part { color: #14365c; margin-right: 2mm; }
h2 .sub { font-family: "PBSans", sans-serif; font-weight: 400; font-size: 8.4pt; color: #55554f; margin-left: 2mm; }

table { width: 100%; border-collapse: collapse; }
th { font-weight: 600; font-size: 7.4pt; text-align: left; color: #333; padding: 1mm 1.5mm 1mm 0; border-bottom: 0.6pt solid #111; vertical-align: bottom; }
td { padding: 1.6mm 1.5mm 1.6mm 0; border-bottom: 0.4pt solid #e1e0da; vertical-align: middle; }
tr { break-inside: avoid; }
tr.group td { font-family: "PBSerif", serif; font-style: italic; color: #55554f; padding-top: 2.2mm; padding-bottom: 0.6mm; border-bottom: 0.4pt solid #b9b8ae; }
.sq { display: inline-block; width: 2.3mm; height: 2.3mm; margin-right: 1.2mm; vertical-align: 0; }

/* Port rows */
.port-name { font-family: "PBSerif", serif; font-weight: 700; font-size: 9.6pt; }
.status { font-size: 7.6pt; white-space: nowrap; }
.gauge { position: relative; width: 30mm; height: 2.8mm; background: #eeeee9; }
.gauge .fill { position: absolute; left: 0; top: 0; bottom: 0; }
.gauge .tick { position: absolute; top: -0.8mm; bottom: -0.8mm; width: 0.5mm; background: #111; }
.gauge.empty { background: repeating-linear-gradient(135deg, #e6e5df 0 0.6mm, #f5f4f0 0.6mm 1.4mm); }
.gauge-label { font-size: 7pt; color: #55554f; margin-top: 0.6mm; white-space: nowrap; }
.days { white-space: nowrap; }
.day { display: inline-block; width: 3.6mm; text-align: center; margin-right: 0.4mm; }
.day b { display: block; font-size: 5.8pt; color: #6b6b66; font-weight: 600; }
.day i { display: block; height: 3.6mm; background: #eeeee9; }
.day i.watch { background: #b7791f; }
.day i.likely { background: #b3261e; }
.action { font-family: "PBSerif", serif; font-size: 9pt; line-height: 1.28; }

/* Routes */
figure { margin: 0 0 2.5mm; break-inside: avoid; }
figure svg { width: 100%; height: auto; display: block; }
figcaption { font-size: 7.4pt; color: #55554f; margin-top: 1mm; }
.swatch { display: inline-block; width: 4.4mm; height: 2.4mm; margin: 0 1mm 0 1.6mm; vertical-align: -0.2mm; opacity: 0.85; }
.swatch.sev-likely { background-image: radial-gradient(#4a2e0c 0.35pt, transparent 0.5pt); background-size: 1.1mm 1.1mm; }
.swatch.sev-extreme { background-image: repeating-linear-gradient(45deg, #4a2e0c 0 0.3pt, transparent 0.3pt 1.1mm); }
table.routes td { padding: 1.5mm 1mm 1.5mm 0; }
.route-name { font-family: "PBSerif", serif; font-weight: 700; font-size: 9pt; white-space: nowrap; }
.chain { white-space: nowrap; font-size: 0; }
.seg { display: inline-block; font-size: 6.2pt; line-height: 1; padding: 1.2mm 1mm; margin-right: 0.5mm; background: #f1f0eb; color: #6b6b66; }
.seg.watch { background: #d9a441; color: #1d1405; }
.seg.likely { background: #d9762b; color: #fff; }
.seg.extreme { background: #b3261e; color: #fff; }
.seg sup { font-weight: 700; font-size: 5.6pt; margin-left: 0.6mm; vertical-align: 0.3mm; }
.delay { font-weight: 700; font-size: 8.2pt; white-space: nowrap; }
.delay.none { font-weight: 400; color: #6b6b66; }
table.key td { padding: 0.9mm 1.5mm 0.9mm 0; font-size: 7.6pt; }
.disc { display: inline-block; width: 3.8mm; height: 3.8mm; line-height: 3.8mm; border-radius: 50%; border: 0.6pt solid #111; text-align: center; font-weight: 700; font-size: 6.4pt; }

/* News */
.two { display: table; width: 100%; table-layout: fixed; }
.two > div { display: table-cell; vertical-align: top; width: 50%; }
.two > div + div { padding-left: 6mm; }
.col-title { font-weight: 700; font-size: 8.6pt; border-bottom: 0.6pt solid #111; padding-bottom: 1mm; margin-bottom: 1mm; }
.notice { padding: 1.3mm 0; border-bottom: 0.4pt solid #e1e0da; break-inside: avoid; }
.notice .tag { font-size: 6.8pt; font-weight: 700; white-space: nowrap; margin-right: 1.5mm; }
.notice .head { font-family: "PBSerif", serif; font-size: 8.8pt; line-height: 1.25; }
.notice .src { display: block; font-size: 6.8pt; color: #6b6b66; margin-top: 0.3mm; }
.rel { margin-top: 4mm; }
.rel svg { width: 100%; height: auto; }
.foot { margin-top: 4mm; border-top: 0.4pt solid #b9b8ae; padding-top: 1.5mm; font-size: 6.8pt; color: #6b6b66; }
.foot p { margin-bottom: 1mm; }
</style>
</head>
<body>

{% if meta.mode == 'dry-run' %}<p class="notice-line">Dry run from cached data. Not for distribution.</p>{% endif %}
{% if meta.mode == 'illustration' %}<p class="notice-line">Illustration with synthetic congestion and weather. Not a real forecast.</p>{% endif %}

<div class="mast">
  <div class="wordmark">Port Brief</div>
  <div class="dateline">{% if issue_number %}Issue {{ issue_number }}, {% endif %}{{ issue_long }}</div>
</div>
<div class="rule-double"></div>

<h1>{{ ed.headline }}</h1>

<div class="overview">
  <div class="lines">
    {% for n, key, title in [(1, 'ports', 'Port health'), (2, 'weather', 'Weather on the way in'), (3, 'news', 'News and notices')] %}
    <div class="ov-line"><div class="ov-num">{{ n }}</div><div class="ov-body"><div class="ov-title">{{ title }}</div><div class="ov-text">{{ ed.summary[key] }}</div></div></div>
    {% endfor %}
  </div>
  <div>{{ europe_map_svg|safe }}
    <div class="small">{% for k, label in [('normal', 'Running normally'), ('watch', 'Watch'), ('congested', 'Congested'), ('disruption', 'Disruption likely')] %}<span style="white-space:nowrap"><span class="sq" style="background: {{ status_colours[k] }}"></span>{{ label }}</span>&nbsp;&nbsp; {% endfor %}</div>
  </div>
</div>

<!-- PART 1 -->
<h2><span class="part">1</span>Port health check<span class="sub">Congestion, the next seven days of weather, and what to do</span></h2>
<table>
  <tr><th>Port</th><th>Berth occupancy vs normal</th><th>Crane weather, next 7 days</th><th>What to do</th></tr>
  {% for region, label in [('uk', 'United Kingdom'), ('north_europe', 'North Europe')] %}
  <tr class="group"><td colspan="4">{{ label }}</td></tr>
  {% for p in port_rows if p.region == region %}
  <tr>
    <td style="width:33mm"><div class="port-name">{{ p.name }}</div><div class="status"><span class="sq" style="background: {{ status_colours[p.status] }}"></span>{{ p.status_label }}</div></td>
    <td style="width:36mm">
      {% if p.occ is not none %}
      <div class="gauge"><div class="fill" style="width: {{ [p.occ, 100]|min }}%; background: {{ p.gauge_colour }}"></div>{% if p.normal is not none %}<div class="tick" style="left: {{ [[p.normal, 0]|max, 100]|min }}%"></div>{% endif %}</div>
      <div class="gauge-label">{{ p.occ|num(0) }}%{% if p.gap is not none %}, {{ p.gap|signed }} on normal{% endif %}{% if p.tip is not none %} · stay {{ p.tip|num(0) }} h{% if p.tip_trend == 'up' %} ↑{% elif p.tip_trend == 'down' %} ↓{% endif %}{% endif %}</div>
      {% else %}
      <div class="gauge empty"></div><div class="gauge-label">Awaiting data</div>
      {% endif %}
    </td>
    <td style="width:34mm" class="days">{% for d in p.days %}<span class="day"><b>{{ (d.date|short_day)[:1] }}</b><i class="{{ d.level }}"></i></span>{% endfor %}</td>
    <td class="action">{{ p.note }}</td>
  </tr>
  {% endfor %}
  {% endfor %}
</table>
<p class="small" style="margin-top:1.5mm">
  Gauge: bar is berth occupancy, black tick is the port's normal level; orange when 10 points or more above normal. Day squares: <span class="sq" style="background:#b7791f"></span>gusts near crane limits <span class="sq" style="background:#b3261e"></span>cranes likely stopped.
  {% if congestion_missing %}<strong>Congestion data is not yet connected</strong>, so statuses reflect weather and port news only.{% endif %}
</p>

<!-- PART 2 -->
<div class="page-break"></div>
<h2><span class="part">2</span>Weather on the way in<span class="sub">Rough seas on the routes into the UK, next six days</span></h2>
<figure>
  {{ world_map_svg|safe }}
  <figcaption>{% for k in ['watch', 'likely', 'extreme'] %}<span style="white-space:nowrap"><span class="swatch sev-{{ k }}" style="background-color: {{ severity_colours[k] }}"></span>{{ severity_labels[k] }} {{ severity_sea[k]|num(0) }} m+</span> {% endfor %} &nbsp;Numbers match the route strips and key below.{% if not field_ok %} Sea-state shading unavailable this issue.{% endif %}</figcaption>
</figure>

<table class="routes">
  <tr><th>Route into the UK</th><th>Sea areas along the way, origin to Channel</th><th>Delay</th></tr>
  {% for r in routes %}
  <tr>
    <td class="route-name" style="width:36mm">{{ r.name }}</td>
    <td class="chain">{% for seg in r.segments %}<span class="seg {{ seg.level }}">{{ seg.short }}{% if seg.n %}<sup>{{ seg.n }}</sup>{% endif %}</span>{% endfor %}</td>
    <td style="width:24mm"><span class="delay {{ 'none' if r.level == 'none' }}">{{ r.delay|sentence }}</span></td>
  </tr>
  {% endfor %}
</table>
<p class="small" style="margin-top:1.5mm">{{ ed.inbound_note }}</p>

{% if key_items %}
<table class="key" style="margin-top:2mm">
  <tr><th style="width:7mm">No.</th><th>Sea area</th><th>Severity</th><th>When</th><th>Peak seas</th><th>Delay</th></tr>
  {% for i in key_items %}
  <tr>
    <td><span class="disc">{{ i.n }}</span></td>
    <td><strong>{{ i.name }}</strong></td>
    <td style="white-space:nowrap"><span class="sq" style="background: {{ severity_colours[i.level] }}"></span>{{ i.severity }}</td>
    <td style="white-space:nowrap">{% if i.from_day %}{{ i.from_day|day }}{% if i.to_day and i.to_day != i.from_day %} to {{ i.to_day|day }}{% endif %}{% else %}Now{% endif %}</td>
    <td class="num">{% if i.peak_sea %}{{ i.peak_sea|num(1) }} m{% endif %}</td>
    <td style="white-space:nowrap">{{ i.delay|sentence }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<!-- PART 3 -->
<div class="page-break"></div>
<h2><span class="part">3</span>News and notices<span class="sub">From the ports and shipping lines, past seven days</span></h2>
{% if ed.sections.advisories %}<p class="serif" style="font-size:9.6pt">{{ ed.sections.advisories }}</p>{% endif %}
<p class="small">{% for k, label in [('disruption', 'Disruption'), ('surcharge', 'Surcharge'), ('service', 'Service change'), ('other', 'Other')] %}<span class="sq" style="background: {{ tag_colours[k] }}"></span>{{ label }}&nbsp;&nbsp; {% endfor %}</p>
<div class="two">
  {% for title, items in [('Ports', notices_ports), ('Shipping lines', notices_lines)] %}
  <div>
    <div class="col-title">{{ title }}</div>
    {% for i in items %}
    <div class="notice"><span class="tag" style="color: {{ tag_colours[i.tag] }}"><span class="sq" style="background: {{ tag_colours[i.tag] }}"></span>{{ i.tag_label }}</span><a class="head" href="{{ i.url }}">{{ i.title }}</a>
      <span class="src">{{ i.publisher }}{% if i.published %}, {{ i.published|day }}{% endif %}{% if i.is_new %} · new{% endif %}</span></div>
    {% else %}
    <p class="small">Nothing operational this week.</p>
    {% endfor %}
  </div>
  {% endfor %}
</div>

<div class="two rel">
  <div>
    <div class="col-title">Shipping line reliability{% if dv and dv.period %}, {{ dv.period|period }}{% endif %}</div>
    {% if dumbbell_svg %}{{ dumbbell_svg|safe }}{% else %}<p class="small">Not available this issue.</p>{% endif %}
  </div>
  <div>
    <div class="col-title">What the figures mean</div>
    <p class="serif" style="font-size:9.2pt">{{ ed.sections.reliability }}</p>
    <p class="small">Share of ships arriving on time. Sea-Intelligence counts arrivals within a day of schedule; Xeneta counts only arrivals on the scheduled day, so its figures run lower.</p>
  </div>
</div>

<div class="foot">
  <p>Weather flags are forecasts, not port notices. Confirm with your terminal or carrier before changing plans.</p>
  <p>{% for a in attributions %}{{ a.rstrip('.') }}.{% if not loop.last %} {% endif %}{% endfor %} Maps use Natural Earth data.</p>
  <p>Data this issue: {% for name, h in health.items() %}{{ health_names.get(name, name) }} {{ health_words.get(h.status, h.status) }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
</div>

</body>
</html>
