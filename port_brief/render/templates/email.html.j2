<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light">
<title>Port Brief, {{ issue_long }}</title></head>
<body style="margin:0;padding:0;background:#ffffff;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <tr><td style="padding:0 0 6px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td style="font-family:Georgia,serif;font-size:28px;font-weight:bold;color:#14365c;">Port Brief</td>
      <td align="right" style="font-size:12px;color:#333333;">{% if issue_number %}Issue {{ issue_number }}, {% endif %}{{ issue_long }}</td>
    </tr></table>
  </td></tr>
  <tr><td style="border-top:2px solid #14365c;border-bottom:1px solid #14365c;height:2px;font-size:0;line-height:0;">&nbsp;</td></tr>
  <tr><td style="padding:18px 0 6px;font-family:Georgia,serif;font-size:24px;line-height:1.2;font-weight:bold;">{{ ed.headline }}</td></tr>
  <tr><td style="padding:0 0 6px;font-family:Georgia,serif;font-size:16px;line-height:1.5;color:#222222;">{{ ed.summary.ports|full_stop }} {{ ed.summary.weather|full_stop }} {{ ed.summary.news|full_stop }}</td></tr>

  <tr><td style="padding:14px 0 4px;font-family:Georgia,serif;font-size:18px;font-weight:bold;border-bottom:1px solid #111111;">Port health check</td></tr>
  {% for p in port_rows %}
  <tr><td style="padding:7px 0;border-bottom:1px solid #e3e2dc;font-size:14px;line-height:1.4;">
    <span style="display:inline-block;width:9px;height:9px;background:{{ status_colours[p.status] }};"></span>&nbsp;<strong>{{ p.name }}</strong>
    <span style="color:#55554f;font-size:12px;">&nbsp;{{ p.status_label }}{% if p.occ is not none %}, berths {{ p.occ|num(0) }}%{% if p.gap is not none %} ({{ p.gap|signed }} on normal){% endif %}{% endif %}</span><br>
    <span style="font-family:Georgia,serif;">{{ p.note }}</span>
  </td></tr>
  {% endfor %}
  {% if congestion_missing %}<tr><td style="padding:6px 0 0;font-size:12px;color:#55554f;">Congestion data is not yet connected; statuses reflect weather and port news only.</td></tr>{% endif %}

  <tr><td style="padding:18px 0 4px;font-family:Georgia,serif;font-size:18px;font-weight:bold;border-bottom:1px solid #111111;">Weather on the way in</td></tr>
  {% for r in routes %}
  <tr><td style="padding:6px 0;border-bottom:1px solid #e3e2dc;font-size:14px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td>{% if r.level != 'none' %}<span style="display:inline-block;width:9px;height:9px;background:{{ severity_colours[r.level] }};"></span>{% else %}<span style="display:inline-block;width:9px;height:9px;background:#e1e0da;"></span>{% endif %}&nbsp;{{ r.name }}</td>
      <td align="right" style="{% if r.level != 'none' %}font-weight:bold;{% else %}color:#6b6b66;{% endif %}">{{ r.delay|sentence }}</td>
    </tr></table>
  </td></tr>
  {% endfor %}

  <tr><td style="padding:18px 0 4px;font-family:Georgia,serif;font-size:18px;font-weight:bold;border-bottom:1px solid #111111;">News and notices</td></tr>
  {% for i in (notices_ports + notices_lines)[:6] %}
  <tr><td style="padding:6px 0;border-bottom:1px solid #e3e2dc;font-size:14px;line-height:1.4;">
    <span style="font-size:11px;font-weight:bold;color:#333333;">{{ i.tag_label }}</span>&nbsp; <a href="{{ i.url }}" style="color:#111111;text-decoration:none;">{{ i.title }}</a>
  </td></tr>
  {% endfor %}

  <tr><td style="padding:22px 0;">
    <a href="{{ '{{PDF_URL}}' }}" style="display:inline-block;background:#14365c;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;padding:12px 22px;">Open the full brief (PDF)</a>
    <p style="margin:10px 0 0;font-size:12px;color:#55554f;">With the port map, storm map, route strips and line reliability.</p>
  </td></tr>
  <tr><td style="border-top:1px solid #b9b8ae;padding:12px 0 0;font-size:11px;line-height:1.5;color:#6b6b66;">
    {% for a in attributions %}{{ a.rstrip(".") }}. {% endfor %}<br>
    Weather flags come from forecasts. Check with your terminal or carrier before changing plans.<br><br>
    <a href="{{ '{{{RESEND_UNSUBSCRIBE_URL}}}' }}" style="color:#6b6b66;">Unsubscribe</a>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>
